{
  "name": "agy-token-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Google Antigravity 2.0 桌面版原生 Token 用量与实时配额分析 MCP App 插件",
  "scripts": {
    "build:web": "vite build --config web/vite.config.mjs",
    "build:server": "esbuild server/index.mjs --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs",
    "build": "npm run build:web && npm run build:server",
    "test:parser": "python parser/test_engine.py"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
